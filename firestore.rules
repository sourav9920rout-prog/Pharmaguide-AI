rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /drugs_v3/{drugName} {
      allow read: if true;
      allow write: if true;
    }

    match /interactions_v3/{interactionId} {
      allow read: if true;
      allow write: if true;
    }

    match /recalls_v1/{drugName} {
      allow read: if true;
      allow write: if true;
    }

    match /brand_map_v2/{brandName} {
      allow read: if true;
      allow write: if true;
    }
  }
}
