{
  "entities": {
    "Drug": {
      "title": "Drug",
      "description": "Cached drug information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["name", "data"]
    },
    "Interaction": {
      "title": "Interaction",
      "description": "Cached drug-drug interaction information",
      "type": "object",
      "properties": {
        "drugs": { "type": "array" },
        "data": { "type": "object" }
      },
      "required": ["drugs", "data"]
    }
  },
  "firestore": {
    "/drugs/{drugName}": {
      "schema": "Drug",
      "description": "Drug information cache"
    },
    "/interactions/{interactionId}": {
      "schema": "Interaction",
      "description": "Interaction information cache"
    }
  }
}
